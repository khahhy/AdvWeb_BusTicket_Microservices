{
  "name": "AdvWeb_BusTicket_Microservices",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:gateway": "nest start gateway --watch",
    "start:dev:identity": "nest start identity --watch",
    "start:dev:support": "nest start support --watch",
    "start:dev:trip": "nest start trip --watch",
    "start:dev:booking": "nest start booking --watch",
    "start:dev:payment": "nest start payment --watch",
    "start:all": "concurrently -k -p \"[{name}]\" -n \"GATEWAY,IDENTITY,SUPPORT,TRIP,BOOKING,PAYMENT\" -c \"cyan.bold,green.bold,magenta.bold,yellow.bold,blue.bold,red.bold\" \"npm run start:dev:gateway\" \"npm run start:dev:identity\" \"npm run start:dev:support\" \"npm run start:dev:trip\" \"npm run start:dev:booking\" \"npm run start:dev:payment\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/AdvWeb_BusTicket_Microservices/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/AdvWeb_BusTicket_Microservices/test/jest-e2e.json",
    "generate:payment": "npx prisma generate --schema=./apps/payment/prisma/schema.prisma",
    "generate:identity": "npx prisma generate --schema=./apps/identity/prisma/schema.prisma",
    "generate:trip": "npx prisma generate --schema=./apps/trip/prisma/schema.prisma",
    "generate:booking": "npx prisma generate --schema=./apps/booking/prisma/schema.prisma",
    "generate:support": "npx prisma generate --schema=./apps/support/prisma/schema.prisma",
    "prisma:generate:all": "concurrently \"npm run generate:payment\" \"npm run generate:identity\" \"npm run generate:trip\" \"npm run generate:booking\" \"npm run generate:support\"",
    "postinstall": "npm run prisma:generate:all",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^11.1.10",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.11",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/websockets": "^11.1.10",
    "@payos/node": "^2.0.3",
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "nodemailer": "^7.0.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "twilio": "^5.11.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.4",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "prisma": "^6.19.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/shared(|/.*)$": "<rootDir>/libs/shared/src/$1"
    }
  }
}
